# ================================================
# === Java Build & Dependency Directories ========
# ================================================
target/
build/
out/

# Exclude nested target/build in source directories
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

